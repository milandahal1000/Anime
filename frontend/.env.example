VITE_API_BASE_URL=/api
# Optional: self-hosted Consumet (or aniwatch-api) instance for real anime streams.
# Leave empty to auto-rotate through public instances.
VITE_CONSUMET_BASE=
# Optional: local MiruroAPI instance (primary stream source).
# Defaults to http://localhost:3000/api
VITE_MIRURO_BASE=http://localhost:3000/api
